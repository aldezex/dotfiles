  email = alvarohdezex@gmail.com

[alias]
  co = checkout
  st = status
  rh = reset HEAD
  rhh = reset --hard HEAD
  pu = pull
  up = push

  l = "!. ~/.githelpers && pretty_git_log"
  la = "!git l --all"
  lr = "!git l -30"
  lra = "!git lr --all"
  lg = "!git l -G $1 -- $2"
  feature = !sh -c 'git checkout --no-track -b $0 origin/main'

  ruf = "!. ~/.githelpers && remove_untracked_files"

	tree = log --oneline --decorate --graph

  # Taken from here: https://aaronbonner.io/post/80766268890/git-alias-to-simplify-setting-upstream-branch
  sup = "!git branch --set-upstream-to=origin/`git symbolic-ref --short HEAD`"
[core]
  excludesfile = ~/.config/git/ignore
  # delta: paginador de diffs con sintaxis y números de línea.
  # El `|| less` no es cosmético: git lanza el paginador con `sh -c`, así que en
  # una máquina donde delta no esté instalado esto sale 127 y cae a less, en vez
  # de dejar `git diff` roto. Este fichero se comparte entre máquinas.
  pager = delta 2>/dev/null || less

[interactive]
  # Mismo motivo que arriba: sin el `|| cat`, un `git add -p` en una máquina sin
  # delta se quedaría sin poder pintar el hunk.
  diffFilter = delta --color-only 2>/dev/null || cat

[delta]
  line-numbers = true
  navigate = true      # n / N para saltar de fichero a fichero dentro del diff

[merge]
  conflictstyle = zdiff3

[diff]
  colorMoved = default

[color]
  diff = auto
  status = auto
  branch = auto
	ui = true

[push]
	default = current
	followTags = true

[remote]
  pushDefault = origin

[branch]
	autosetuprebase = always

[diff "gpg"]
	binary = true
	textconv = gpg -d --quiet --yes --compress-algo=none --no-encrypt-to --batch --use-agent

[commit]
	verbose = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[protocol "file"]
	allow = always
# Puesto por `gh auth setup-git`, con la ruta al binario reescrita a mano.
# gh escribe ahí la ruta ABSOLUTA de la máquina donde se lanzó
# (/home/scami/.local/bin/gh en la WSL), y este fichero se comparte: en el Mac
# esa ruta no existe. Basta con `gh`, que se resuelve por PATH en las tres.
# El `helper = ` vacío de cada bloque no sobra: descarta los helpers heredados
# de configuraciones de sistema antes de poner el nuestro.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
