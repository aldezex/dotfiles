[user]
  name = Álvaro Hernández
  email = alvarohdezex@gmail.com

[alias]
  co = checkout
  st = status
  rh = reset HEAD
  rhh = reset --hard HEAD
  pu = pull
  up = push

  l = "!. ~/.githelpers && pretty_git_log"
  la = "!git l --all"
  lr = "!git l -30"
  lra = "!git lr --all"
  lg = "!git l -G $1 -- $2"
  feature = !sh -c 'git checkout --no-track -b $0 origin/main'

  ruf = "!. ~/.githelpers && remove_untracked_files"

  tree = log --oneline --decorate --graph

[core]
  # delta: diff pager with syntax highlighting and line numbers.
  # The `|| less` is not cosmetic: git launches the pager with `sh -c`, so on a
  # machine without delta this exits 127 and falls back to less instead of
  # leaving `git diff` broken. This file is shared across machines.
  pager = delta 2>/dev/null || less

[interactive]
  # Same reason: without the `|| cat`, `git add -p` on a machine without delta
  # would have nothing to render the hunk with.
  diffFilter = delta --color-only 2>/dev/null || cat

[delta]
  line-numbers = true
  navigate = true      # n / N jump between files inside the diff

[color]
  diff = auto
  status = auto
  branch = auto
  ui = true

[push]
  default = current
  followTags = true
  # Creates the branch on origin on first push. Replaces the old `sup` alias.
  autoSetupRemote = true

[remote]
  pushDefault = origin

[branch]
  autosetuprebase = always
  # `git branch` by recency instead of alphabetically, matching how `fo` sorts.
  sort = -committerdate

[diff]
  # histogram reads considerably better than the default algorithm.
  algorithm = histogram
  # Tells moved code apart from genuinely added code.
  colorMoved = zebra

[merge]
  # Shows the common ancestor in a conflict too, not just the two sides.
  conflictStyle = zdiff3

[rerere]
  # Remembers how a conflict was resolved and replays it. With
  # autosetuprebase = always this pays off as soon as a rebase drags on.
  enabled = true
  autoUpdate = true

[diff "gpg"]
  binary = true
  textconv = gpg -d --quiet --yes --compress-algo=none --no-encrypt-to --batch --use-agent

[commit]
  verbose = true

[init]
  defaultBranch = main

[pull]
  rebase = true

# Written by `gh auth setup-git`, with the path to the binary rewritten by hand.
# gh writes the ABSOLUTE path of the machine it ran on, and this file is shared
# between machines, so that path does not exist on the other one. Plain `gh`
# resolves through PATH everywhere.
# The empty `helper =` in each block is not redundant: it discards helpers
# inherited from system-wide configuration before ours is added.
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential

# protocol.file.allow used to be "always", which reopens the CVE-2022-39253
# vector (a hostile .gitmodules pointing at local paths) in every repo you
# clone. When a local-submodule test needs it, pass it per invocation:
#     git -c protocol.file.allow=always clone …
