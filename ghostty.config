theme = Ayu Mirage
font-family = FiraCode Nerd Font Mono
font-size = 13

# Right Option only: herdr still gets its alt+left/right/up/down pane bindings
# (right Option), while left Option keeps composing. On Spanish ISO that matters
# — { } [ ] \ | @ # all need Option, and `true` made them untypable.
macos-option-as-alt = right

window-padding-x = 8
window-padding-y = 6
window-save-state = always

scrollback-limit = 10000000
copy-on-select = clipboard
mouse-hide-while-typing = true

# The shell is always something recoverable; the prompt on every close is not
# worth it.
confirm-close-surface = false
