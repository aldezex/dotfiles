theme = Ayu Mirage
font-family = FiraCode Nerd Font Mono
font-size = 13

# Both Option keys compose. On Spanish ISO { } [ ] \ | @ # € all need Option,
# and muscle memory reaches for whichever one is closer — making either of them
# an Alt key makes those characters untypable half the time.
macos-option-as-alt = false

# herdr's alt+arrow pane bindings, sent explicitly. Arrows compose nothing on
# macOS, so binding them costs no characters. The number row is deliberately
# left alone: alt+1..9 is where | @ # live.
keybind = alt+left=csi:1;3D
keybind = alt+down=csi:1;3B
keybind = alt+up=csi:1;3A
keybind = alt+right=csi:1;3C

# Borrado por palabras. Backspace/Delete tampoco componen nada, asi que se
# enlazan igual que las flechas: ESC+DEL = backward-kill-word, ESC+d =
# kill-word en zsh (y en el prompt de Claude Code).
keybind = alt+backspace=text:\x1b\x7f
keybind = alt+delete=text:\x1bd

window-padding-x = 8
window-padding-y = 6
window-save-state = always

scrollback-limit = 10000000
copy-on-select = clipboard
mouse-hide-while-typing = true

# The shell is always something recoverable; the prompt on every close is not
# worth it.
confirm-close-surface = false
