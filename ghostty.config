theme = Ayu Mirage
font-family = FiraCode Nerd Font Mono
font-size = 13

# Without this, Option composes accented characters instead of sending Alt, so
# herdr never receives its alt+left/right/up/down pane bindings.
macos-option-as-alt = true

window-padding-x = 8
window-padding-y = 6
window-save-state = always

scrollback-limit = 10000000
copy-on-select = clipboard
mouse-hide-while-typing = true

# The shell is always something recoverable; the prompt on every close is not
# worth it.
confirm-close-surface = false
