{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_HOME:-$HOME/.codex}/herdr-agent-state.sh\" session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/session-cleanup.py\" hook",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/session-cleanup.py\" hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
